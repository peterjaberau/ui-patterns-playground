    "components": {
      "ChartAreaAxes": [
        "named-export",
        "dynamic(import('path.tsx')).then(m => m.ChartAreaAxes)",
        "export function ChartAreaAxes() { return <div>ChartAreaAxes</div> }"
      ],

      "sidebar-01": [
        "default-export",
        "dynamic(import('path.tsx'))",
        "export default function Sidebar01() { return <div>Sidebar01</div> }"
      ]
