{
  "extends": "@codefast/typescript-config/react.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "dist",
    "declaration": true,
    "paths": {
      "@/*": ["./src/*"],
      "form-render": ["packages/form-render/src/*"]
    }
  },
  "noImplicitAny": false,
  "allowJs": true,
  "allowSyntheticDefaultImports": true,
  "resolveJsonModule": true,
  "moduleResolution": "node",
  "skipLibCheck": true,

  "types": ["typing.d.ts"],
  "include": ["**/*.ts", "**/*.tsx", "typing.d.ts"],
  "exclude": ["node_modules", "dist"]
}
