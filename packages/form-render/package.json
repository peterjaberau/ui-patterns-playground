{
  "name": "form-render",
  "version": "2.5.2",
  "description": "Generate standard Form through JSON Schema, often used for custom configuration interface generation",
  "keywords": [
    "Form",
    "FormRender",
    "Render",
    "XRender",
    "React",
    "Json Schema",
    "Ant Design"
  ],
  "bugs": {
    "url": ""
  },
  "repository": {
    "type": "git",
    "url": "",
    "directory": "packages/ui"
  },
  "license": "MIT",
  "author": "",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/index.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "source": "./src/index.ts",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf node_modules dist",
    "dev": "tsup --watch",
    "lint": "TIMING=1 eslint --max-warnings 0",
    "lint:inspect": "npx @eslint/config-inspector@latest"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "@rc-component/color-picker": "^3.0.1",
    "ahooks": "^3.7.5",
    "async-validator": "^4.2.5",
    "classnames": "^2.3.1",
    "clsx": "^2.1.1",
    "color": "^5.0.0",
    "dayjs": "^1.11.7",
    "lodash-es": "^4.17.21",
    "rc-field-form": "^2.7.0",
    "rc-picker": "^4.11.3",
    "tailwind-merge": "^3.0.2",
    "tailwind-variants": "^1.0.0",
    "virtualizedtableforantd4": "^1.3.1",
    "zustand": "^4.1.5"
  },
  "devDependencies": {
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@codefast/eslint-config": "workspace:*",
    "@codefast/typescript-config": "workspace:*",
    "@tailwindcss/postcss": "^4.0.15",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.13.11",
    "deep-equal": "^2.0.3",
    "eslint": "^9.23.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.15",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "@types/react": "*",
    "@types/react-dom": "*",
    "antd": "5.x",
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
